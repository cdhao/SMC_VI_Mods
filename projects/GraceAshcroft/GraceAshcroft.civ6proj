<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="12.0" DefaultTargets="Default" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Default</Configuration>
    <Name>GraceAshcroft</Name>
    <Guid>8cf6756d-3ec5-43d4-9857-c16f46a9a440</Guid>
    <ProjectGuid>1f77e2a1-c977-4eb4-a3e2-6cb1b9b60b49</ProjectGuid>
    <ModVersion>2</ModVersion>
    <Teaser>Clear barbarian threats, collect Infected Blood, and convert samples into combat and science.</Teaser>
    <Description>Adds Grace Ashcroft and the Elpis Protocol civilization.</Description>
    <Authors>Codex</Authors>
    <AffectsSavedGames>true</AffectsSavedGames>
    <SupportsSinglePlayer>true</SupportsSinglePlayer>
    <SupportsMultiplayer>true</SupportsMultiplayer>
    <SupportsHotSeat>true</SupportsHotSeat>
    <CompatibleVersions>1.2,2.0</CompatibleVersions>
    <AssemblyName>GraceAshcroft</AssemblyName>
    <RootNamespace>GraceAshcroft</RootNamespace>
    <AssetsPath>..\..\assets\GraceAshcroft\cooker</AssetsPath>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Default' ">
    <OutputPath>..\..\mods\GraceAshcroft</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <None Include="GraceAshcroft.Art.xml" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\mods\GraceAshcroft\ArtDefs\*.artdef">
      <Link>ArtDefs\%(Filename)%(Extension)</Link>
    </Content>
    <Content Include="..\..\mods\GraceAshcroft\Data\*.*">
      <Link>Data\%(Filename)%(Extension)</Link>
    </Content>
    <Content Include="..\..\mods\GraceAshcroft\Icons\*.*">
      <Link>Icons\%(Filename)%(Extension)</Link>
    </Content>
    <Content Include="..\..\mods\GraceAshcroft\Scripts\*.*">
      <Link>Scripts\%(Filename)%(Extension)</Link>
    </Content>
    <Content Include="..\..\mods\GraceAshcroft\Text\*.*">
      <Link>Text\%(Filename)%(Extension)</Link>
    </Content>
    <Content Include="..\..\mods\GraceAshcroft\GraceAshcroft.dep">
      <Link>GraceAshcroft.dep</Link>
    </Content>
    <Content Include="..\..\mods\GraceAshcroft\GraceAshcroft.modinfo">
      <Link>GraceAshcroft.modinfo</Link>
    </Content>
    <Content Include="..\..\mods\GraceAshcroft\Platforms\Windows\BLPs\*.blp">
      <Link>Platforms\Windows\BLPs\%(Filename)%(Extension)</Link>
    </Content>
    <Content Include="..\..\assets\GraceAshcroft\cooker\Images\Textures\*.tex">
      <Link>Images\Textures\%(Filename)%(Extension)</Link>
    </Content>
    <Content Include="..\..\assets\GraceAshcroft\cooker\XLPs\*.xlp">
      <Link>XLPs\%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>
  <Import Project="$(MSBuildLocalExtensionPath)Civ6.targets" />
</Project>
