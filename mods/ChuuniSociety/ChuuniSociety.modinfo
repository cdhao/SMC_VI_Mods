<?xml version="1.0" encoding="utf-8"?>
<Mod id="2bba8a5b-11c1-461b-a451-4cc1d105b2dc" version="1">
  <Properties>
    <Name>极东魔术昼寝结社之夏</Name>
    <Description>添加极东魔术昼寝结社之夏文明与领袖小鸟游六花。</Description>
    <Teaser>积累中二值，突破现实与不可视境界线。</Teaser>
    <Authors>Codex</Authors>
    <CompatibleVersions>2.0</CompatibleVersions>
  </Properties>
  <Dependencies>
    <Mod id="4873eb62-8ccc-4574-b784-dda455e74e68" title="Expansion: Gathering Storm" />
  </Dependencies>
  <ActionCriteria>
    <Criteria id="ChuuniExpansion2">
      <GameCoreInUse>Expansion2</GameCoreInUse>
    </Criteria>
  </ActionCriteria>
  <FrontEndActions>
    <UpdateDatabase id="ChuuniConfig">
      <Properties>
        <LoadOrder>20</LoadOrder>
      </Properties>
      <File>Data/Config.sql</File>
    </UpdateDatabase>
    <UpdateText id="ChuuniTextFrontEnd">
      <File>Text/Chuuni_zh_Hans_CN.sql</File>
    </UpdateText>
    <UpdateIcons id="ChuuniIconsFrontEnd">
      <File>Icons/ChuuniIcons.sql</File>
    </UpdateIcons>
    <UpdateColors id="ChuuniColorsFrontEnd">
      <File>Data/Colors.xml</File>
    </UpdateColors>
    <UpdateArt id="ChuuniArtFrontEnd">
      <File>ChuuniSociety.dep</File>
    </UpdateArt>
  </FrontEndActions>
  <InGameActions>
    <UpdateDatabase id="ChuuniCore" criteria="ChuuniExpansion2">
      <Properties>
        <LoadOrder>100</LoadOrder>
      </Properties>
      <File>Data/Core.sql</File>
    </UpdateDatabase>
    <UpdateDatabase id="ChuuniStageCombat" criteria="ChuuniExpansion2">
      <Properties>
        <LoadOrder>105</LoadOrder>
      </Properties>
      <File>Data/StageCombat.sql</File>
    </UpdateDatabase>
    <UpdateDatabase id="ChuuniChimera" criteria="ChuuniExpansion2">
      <Properties>
        <LoadOrder>107</LoadOrder>
      </Properties>
      <File>Data/Chimera.sql</File>
    </UpdateDatabase>
    <UpdateDatabase id="ChuuniDistrictBuilding" criteria="ChuuniExpansion2">
      <Properties>
        <LoadOrder>110</LoadOrder>
      </Properties>
      <File>Data/DistrictBuilding.sql</File>
    </UpdateDatabase>
    <AddGameplayScripts id="ChuuniGameplay" criteria="ChuuniExpansion2">
      <Properties>
        <LoadOrder>200</LoadOrder>
      </Properties>
      <File>Scripts/ChuuniGameplay.lua</File>
    </AddGameplayScripts>
    <AddUserInterfaces id="ChuuniStatusHUD" criteria="ChuuniExpansion2">
      <Properties>
        <Context>InGame</Context>
        <LoadOrder>210</LoadOrder>
      </Properties>
      <File>UI/ChuuniStatusHUD.xml</File>
    </AddUserInterfaces>
    <UpdateText id="ChuuniTextInGame" criteria="ChuuniExpansion2">
      <File>Text/Chuuni_zh_Hans_CN.sql</File>
    </UpdateText>
    <UpdateIcons id="ChuuniIconsInGame" criteria="ChuuniExpansion2">
      <File>Icons/ChuuniIcons.sql</File>
    </UpdateIcons>
    <UpdateColors id="ChuuniColorsInGame" criteria="ChuuniExpansion2">
      <File>Data/Colors.xml</File>
    </UpdateColors>
    <UpdateArt id="ChuuniArtInGame" criteria="ChuuniExpansion2">
      <File>ChuuniSociety.dep</File>
    </UpdateArt>
  </InGameActions>
  <Files>
    <File>Data/Config.sql</File>
    <File>Data/Colors.xml</File>
    <File>Data/Core.sql</File>
    <File>Data/StageCombat.sql</File>
    <File>Data/Chimera.sql</File>
    <File>Data/DistrictBuilding.sql</File>
    <File>Scripts/ChuuniGameplay.lua</File>
    <File>UI/ChuuniStatusHUD.xml</File>
    <File>UI/ChuuniStatusHUD.lua</File>
    <File>Text/Chuuni_zh_Hans_CN.sql</File>
    <File>Icons/ChuuniIcons.sql</File>
    <File>ChuuniSociety.dep</File>
    <File>ArtDefs/FallbackLeaders.artdef</File>
    <File>Platforms/Windows/BLPs/ChuuniUITextureV1.blp</File>
    <File>Platforms/Windows/BLPs/ChuuniLeaderFallbacks.blp</File>
  </Files>
</Mod>
